# trakt-mal-sync configuration. Copy to a private file (chmod 600) and pass it with --config.
# One KEY=VALUE per line. Process environment variables win over this file.

# Trakt: an API app's client ID (https://trakt.tv/oauth/applications). No secret, no OAuth:
# the script only reads, so the Trakt profile must be public.
TRAKT_CLIENT_ID=
TRAKT_USER=

# MyAnimeList: a client from https://myanimelist.net/apiconfig. App type "other" issues no secret.
# The redirect URL must match the one registered on the client.
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost/callback

# Where tokens, caches and the last run's report live (default ~/.local/state/trakt-mal-sync).
STATE_DIR=

# Timezone for the start/finish dates written to MAL (IANA name, default UTC).
TIMEZONE=UTC

# Optional manual mapping fixes (default $STATE_DIR/overrides.json). See overrides.example.json.
OVERRIDES_FILE=

# Optional Telegram report after each applied run that changed something or failed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# What to sync (1/0).
SYNC_SPECIALS=1
SYNC_WATCHLIST=1
SYNC_DATES=1

# Trakt ratings -> MAL scores. fill: only where MAL has no score. overwrite: Trakt always wins.
# off: never touch scores. A show rating applies to every season unless the season has its own.
SCORES=fill

# 0: never lower a MAL entry's status or episode count (held-back changes are listed in the log).
# 1: mirror Trakt exactly, even when MAL is ahead.
ALLOW_DOWNGRADE=0

# MAL statuses kept when Trakt only says "watching" (Trakt's public API has no dropped/on-hold).
KEEP_MAL_STATUSES=on_hold,dropped
